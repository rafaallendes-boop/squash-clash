/* Art pass: one palette and one type scale for the in-game HUD (rally bar, score and match result). */
.sc-header {
    background-color: rgba(9, 16, 26, 0.9);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}
.sc-title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(244, 247, 250);
}
.sc-meta {
    font-size: 11px;
    color: rgb(140, 158, 176);
}
.sc-status {
    font-size: 13px;
    color: rgb(214, 224, 234);
}
.unity-button.sc-button {
    height: 44px;
    min-width: 52px;
    font-size: 13px;
    -unity-font-style: bold;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 7px;
    padding-right: 7px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(30, 44, 64);
    color: rgb(236, 242, 248);
}
.unity-button.sc-button:hover { background-color: rgb(38, 55, 79); }
.unity-button.sc-button:active { background-color: rgb(58, 82, 114); }
.unity-button.sc-button:disabled { opacity: 0.45; }
.unity-button.sc-button--primary { background-color: rgb(255, 210, 63); color: rgb(18, 22, 30); }
.unity-button.sc-button--primary:hover { background-color: rgb(255, 218, 92); }
.unity-button.sc-button--primary:active { background-color: rgb(255, 232, 140); }
.sc-score {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 34px;
    margin-top: 2px;
}
.sc-score-name {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(190, 204, 218);
    margin-left: 6px;
    margin-right: 6px;
}
.sc-score-points {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    min-width: 30px;
    -unity-text-align: middle-center;
    margin-left: 2px;
    margin-right: 2px;
    padding: 0;
}
.sc-score-dash { font-size: 20px; color: rgb(120, 138, 156); }
.sc-chip { width: 10px; height: 10px; border-radius: 5px; }
.sc-chip--human { background-color: rgb(30, 136, 255); }
.sc-chip--rival { background-color: rgb(255, 77, 51); }
.sc-serve { width: 6px; height: 6px; border-radius: 3px; background-color: rgb(255, 210, 63); margin-left: 3px; margin-right: 3px; }
.sc-result-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}
.sc-result-card {
    width: 300px;
    padding: 22px;
    align-items: center;
    background-color: rgba(11, 19, 30, 0.97);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgb(255, 210, 63);
}
.sc-result-kicker { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(140, 158, 176); }
.sc-result-title { font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 6px; -unity-text-align: middle-center; white-space: normal; }
.sc-result-score { font-size: 60px; -unity-font-style: bold; color: rgb(255, 210, 63); margin-top: 4px; margin-bottom: 2px; }
.sc-result-note { font-size: 13px; color: rgb(190, 204, 218); margin-bottom: 16px; -unity-text-align: middle-center; white-space: normal; }
.sc-result-buttons { flex-direction: row; justify-content: center; }

/* Feel pass: point banner over the front wall and result card tones. */
.sc-banner-layer {
    position: absolute;
    left: 0; right: 0; top: 0;
    align-items: center;
}
.sc-banner {
    align-items: center;
    padding-left: 22px; padding-right: 22px; padding-top: 10px; padding-bottom: 12px;
    max-width: 92%;
    background-color: rgba(9, 16, 26, 0.92);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
}
.sc-banner--human { border-color: rgb(30, 136, 255); }
.sc-banner--rival { border-color: rgb(255, 77, 51); }
.sc-banner-title { font-size: 24px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.sc-banner--human .sc-banner-title { color: rgb(120, 190, 255); }
.sc-banner--rival .sc-banner-title { color: rgb(255, 140, 120); }
.sc-banner-cause { font-size: 15px; color: rgb(226, 234, 242); margin-top: 2px; -unity-text-align: middle-center; white-space: normal; }
.sc-banner-next { font-size: 13px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(255, 210, 63); margin-top: 6px; -unity-text-align: middle-center; }
.sc-result-card--won { border-color: rgb(255, 210, 63); }
.sc-result-card--lost { border-color: rgb(255, 77, 51); }
.sc-result-card--won .sc-result-kicker { color: rgb(255, 210, 63); }
.sc-result-card--lost .sc-result-kicker { color: rgb(255, 140, 120); }
.sc-result-card--lost .sc-result-score { color: rgb(236, 242, 248); }
.sc-result-last { font-size: 14px; color: rgb(226, 234, 242); margin-bottom: 4px; -unity-text-align: middle-center; white-space: normal; }

/* First run: start menu over the paused court. */
.sc-menu-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    padding-left: 24px; padding-right: 24px; padding-top: 70px; padding-bottom: 56px;
    background-color: rgba(7, 12, 20, 0.93);
}
.sc-menu-art {
    width: 208px; height: 132px;
    margin-bottom: 22px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(255, 210, 63);
    overflow: hidden;
}
.sc-menu-title { font-size: 38px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.sc-menu-tagline { font-size: 15px; color: rgb(190, 204, 218); margin-top: 2px; margin-bottom: 30px; -unity-text-align: middle-center; }
.sc-menu-label { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(140, 158, 176); margin-bottom: 8px; }
.sc-level-row { flex-direction: row; justify-content: center; margin-bottom: 22px; }
.unity-button.sc-level { width: 96px; height: 48px; font-size: 15px; margin-left: 4px; margin-right: 4px; border-width: 2px; border-color: rgba(255, 255, 255, 0); }
.unity-button.sc-level--selected { background-color: rgb(24, 52, 92); border-color: rgb(255, 210, 63); color: rgb(255, 232, 140); }
.unity-button.sc-menu-play { width: 304px; height: 64px; font-size: 24px; letter-spacing: 1px; border-radius: 18px; margin-bottom: 12px; }
.unity-button.sc-menu-wide { width: 304px; height: 50px; font-size: 16px; margin-bottom: 10px; }
.sc-menu-build { position: absolute; left: 0; right: 0; bottom: 30px; font-size: 11px; color: rgb(120, 138, 156); -unity-text-align: middle-center; }

/* First run: three-step tutorial card. */
.sc-tutorial-card {
    width: 338px;
    padding: 20px;
    align-items: center;
    background-color: rgb(13, 22, 35);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}
.sc-tutorial-art { width: 270px; height: 150px; margin-top: 4px; margin-bottom: 16px; border-radius: 14px; background-color: rgb(24, 36, 54); overflow: hidden; }
.sc-tutorial-title { font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 8px; -unity-text-align: middle-center; }
.sc-tutorial-body { font-size: 16px; color: rgb(226, 234, 242); white-space: normal; -unity-text-align: upper-left; width: 100%; margin-bottom: 12px; }
.sc-tutorial-results { width: 100%; margin-bottom: 8px; }
.sc-tutorial-result { flex-direction: row; align-items: flex-start; margin-bottom: 6px; }
.sc-tutorial-chip { width: 12px; height: 12px; border-radius: 6px; margin-top: 8px; margin-right: 8px; flex-shrink: 0; border-width: 2px; border-color: rgb(140, 158, 176); }
.sc-tutorial-chip--perfect { background-color: rgb(255, 204, 41); border-color: rgb(255, 204, 41); }
.sc-tutorial-chip--valid { background-color: rgb(255, 255, 255); border-color: rgb(255, 255, 255); }
.sc-tutorial-result-text { font-size: 14px; color: rgb(214, 224, 234); white-space: normal; flex-shrink: 1; flex-grow: 1; }
.sc-tutorial-buttons { flex-direction: row; justify-content: space-between; width: 100%; margin-top: 8px; }
.unity-button.sc-tutorial-skip { width: 104px; height: 52px; font-size: 15px; margin-left: 0; }
.unity-button.sc-tutorial-next { width: 176px; height: 52px; font-size: 18px; margin-right: 0; }
