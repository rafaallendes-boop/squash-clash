/* Squash Clash look (menu and stroke pass, 18 nov). Two surfaces, both taken from the court:
   - Off the court (start menu, tutorial, pause, result) everything is a piece of the front wall: plaster, ink text and
     the court's red lines. The one primary action on each screen is line red.
   - On the court (header, point banner, shot note) surfaces are dark teal glass, like the back wall, so the court shows through.
   Yellow is the ball's two dots: a Perfect stroke, the server, a won match. Blue and coral stay the players' shirts.
   Type: Rubik (SIL OFL 1.1, Runtime/Visual/Fonts/OFL.txt; static SDF assets baked by Editor/RubikFontAssets.cs). Bold Italic for what moves (wordmark, score, notes, titles, Jugar), Bold for
   controls and names, Regular for reading. Scale 11 / 12 / 14 / 16 / 18 / 24 / 26 / 28 / 40 / 60. */
:root {
    --plaster: rgb(238, 241, 239);
    --plaster-card: rgb(248, 249, 248);
    --ink: rgb(24, 34, 44);
    --ink-soft: rgb(84, 94, 104);
    --ink-line: rgba(24, 34, 44, 0.18);
    --line: rgb(206, 32, 45);
    --line-hover: rgb(222, 50, 62);
    --line-press: rgb(170, 22, 34);
    --dot: rgb(255, 210, 63);
    --glass: rgba(12, 33, 39, 0.9);
    --glass-edge: rgba(168, 228, 226, 0.2);
    --glass-text: rgb(234, 243, 243);
    --glass-soft: rgb(160, 190, 194);
    --human: rgb(30, 136, 255);
    --rival: rgb(255, 77, 51);
}

/* Fonts: set on the player's surfaces only (the developer panel keeps the theme font). */
.sc-header, .sc-menu-layer, .sc-pause-layer, .sc-result-layer, .sc-banner-layer, .sc-shot-note {
    -unity-font-definition: url("../../Visual/Fonts/Rubik-Regular SDF.asset");
    -unity-font-style: normal;
}

/* ---------- On the court: glass ---------- */
.sc-header {
    background-color: var(--glass);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--glass-edge);
    border-top-color: var(--line);
    border-top-width: 2px;
}
.sc-title {
    font-size: 16px;
    -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset");
    -unity-font-style: normal;
    letter-spacing: 0.5px;
    color: var(--glass-text);
}
.sc-meta { font-size: 11px; color: var(--glass-soft); }
.sc-status { font-size: 13px; color: var(--glass-text); }

/* Buttons: glass by default (header); the wall surfaces restyle them below. */
.unity-button.sc-button {
    height: 44px;
    min-width: 52px;
    font-size: 13px;
    -unity-font-definition: url("../../Visual/Fonts/Rubik-Bold SDF.asset");
    -unity-font-style: normal;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 7px;
    padding-right: 7px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.09);
    color: var(--glass-text);
    transition-property: background-color;
    transition-duration: 0.08s;
}
.unity-button.sc-button:hover { background-color: rgba(255, 255, 255, 0.15); }
.unity-button.sc-button:active { background-color: rgba(255, 255, 255, 0.24); }
.unity-button.sc-button:disabled { opacity: 0.45; }
.unity-button.sc-button--primary { background-color: var(--line); border-color: var(--line); color: rgb(255, 255, 255); }
.unity-button.sc-button--primary:hover { background-color: var(--line-hover); }
.unity-button.sc-button--primary:active { background-color: var(--line-press); }

/* Score: the digits are the loudest thing in the header. */
.sc-score {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 34px;
    margin-top: 2px;
}
.sc-score-name {
    font-size: 12px;
    -unity-font-definition: url("../../Visual/Fonts/Rubik-Bold SDF.asset");
    -unity-font-style: normal;
    letter-spacing: 1px;
    color: var(--glass-soft);
    margin-left: 6px;
    margin-right: 6px;
}
.sc-score-points {
    font-size: 26px;
    -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset");
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    min-width: 30px;
    -unity-text-align: middle-center;
    margin-left: 2px;
    margin-right: 2px;
    padding: 0;
}
.sc-score-dash { font-size: 20px; color: var(--glass-soft); }
/* Energy line under each name (F2): 3 px, no touches. Red is deliberately not the rival chip's rgb(255, 77, 51). */
/* Same fixed width for both columns, so TÚ and RIVAL draw bars of equal length at equal energy. */
.sc-energy-col { flex-direction: column; justify-content: center; align-items: stretch; flex-shrink: 0; width: 60px; }
.sc-energy-col > .sc-score-name { -unity-text-align: middle-center; }
.sc-energy { flex-shrink: 0; height: 3px; margin-top: 2px; margin-left: 6px; margin-right: 6px; border-radius: 1px; overflow: hidden; background-color: rgba(255, 255, 255, 0.14); }
.sc-energy-fill { flex-shrink: 0; height: 3px; width: 100%; border-radius: 1px; }
.sc-energy--neutral > .sc-energy-fill { background-color: rgb(176, 222, 220); }
.sc-energy--amber > .sc-energy-fill { background-color: rgb(255, 176, 32); }
.sc-energy--red > .sc-energy-fill { background-color: rgb(214, 40, 64); }
.sc-chip { width: 10px; height: 10px; border-radius: 5px; }
.sc-chip--human { background-color: var(--human); }
.sc-chip--rival { background-color: var(--rival); }
.sc-serve { width: 6px; height: 6px; border-radius: 3px; background-color: var(--dot); margin-left: 3px; margin-right: 3px; }

/* Point banner over the front wall: glass, with the winner's shirt colour along its bottom edge. */
.sc-banner-layer {
    position: absolute;
    left: 0; right: 0; top: 0;
    align-items: center;
}
.sc-banner {
    align-items: center;
    padding-left: 22px; padding-right: 22px; padding-top: 10px; padding-bottom: 10px;
    max-width: 92%;
    background-color: var(--glass);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--glass-edge);
    border-bottom-width: 4px;
    border-bottom-color: var(--glass-soft);
}
.sc-banner--human { border-bottom-color: var(--human); }
.sc-banner--rival { border-bottom-color: var(--rival); }
.sc-banner-title { font-size: 24px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); -unity-font-style: normal; letter-spacing: 1px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.sc-banner--human .sc-banner-title { color: rgb(128, 194, 255); }
.sc-banner--rival .sc-banner-title { color: rgb(255, 150, 130); }
.sc-banner-cause { font-size: 14px; color: var(--glass-text); margin-top: 2px; -unity-text-align: middle-center; white-space: normal; }
.sc-banner-next { font-size: 13px; -unity-font-definition: url("../../Visual/Fonts/Rubik-Bold SDF.asset"); -unity-font-style: normal; color: var(--dot); margin-top: 6px; -unity-text-align: middle-center; }

/* Shot note: the judged stroke in a word, under the court. No box: big slanted type with a shadow over the floor. */
.sc-shot-note {
    position: absolute;
    height: 34px;
    font-size: 24px;
    -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset");
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0px 2px 5px rgba(4, 14, 18, 0.85);
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin: 0;
}
.sc-shot-note--perfect { color: var(--dot); }
.sc-shot-note--valid { color: rgb(255, 255, 255); }
.sc-shot-note--failed { color: rgb(255, 128, 112); }
.sc-shot-note--info { font-size: 16px; -unity-font-definition: url("../../Visual/Fonts/Rubik-Bold SDF.asset"); color: var(--glass-text); }

/* ---------- Off the court: the front wall ---------- */
/* Wall buttons: ink outline on plaster; the primary stays line red. */
.sc-wall .unity-button.sc-button {
    border-width: 2px;
    border-color: var(--ink-line);
    background-color: rgba(24, 34, 44, 0.04);
    color: var(--ink);
}
.sc-wall .unity-button.sc-button:hover { background-color: rgba(24, 34, 44, 0.09); }
.sc-wall .unity-button.sc-button:active { background-color: rgba(24, 34, 44, 0.16); }
.sc-wall .unity-button.sc-button--primary { background-color: var(--line); border-color: var(--line); color: rgb(255, 255, 255); }
.sc-wall .unity-button.sc-button--primary:hover { background-color: var(--line-hover); }
.sc-wall .unity-button.sc-button--primary:active { background-color: var(--line-press); }

.sc-result-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}
/* A card is a piece of the wall with its out line along the top. */
.sc-result-card {
    width: 300px;
    padding: 22px;
    padding-bottom: 18px;
    align-items: center;
    background-color: var(--plaster-card);
    border-radius: 18px;
    border-width: 0;
    border-top-width: 6px;
    border-color: var(--line);
}
.sc-result-kicker { font-size: 12px; -unity-font-definition: url("../../Visual/Fonts/Rubik-Bold SDF.asset"); -unity-font-style: normal; letter-spacing: 3px; color: var(--ink-soft); }
.sc-result-title { font-size: 28px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); -unity-font-style: normal; color: var(--ink); margin-top: 6px; -unity-text-align: middle-center; white-space: normal; }
.sc-result-score { font-size: 60px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); -unity-font-style: normal; color: var(--ink); margin-top: 0; margin-bottom: 0; }
.sc-result-note { font-size: 13px; color: var(--ink-soft); margin-bottom: 16px; -unity-text-align: middle-center; white-space: normal; }
.sc-result-buttons { flex-direction: row; flex-wrap: wrap; justify-content: center; }
/* 46: still 44 or more once its edges snap to whole pixels, at any panel scale and any card position. */
.sc-result-buttons .unity-button.sc-button { height: 46px; margin-top: 4px; margin-bottom: 4px; padding-left: 14px; padding-right: 14px; font-size: 14px; }
.sc-result-card--won { border-top-color: var(--dot); }
.sc-result-card--lost { border-top-color: var(--rival); }
.sc-result-card--won .sc-result-kicker { color: rgb(138, 96, 0); }
.sc-result-card--lost .sc-result-kicker { color: var(--line); }
.sc-result-card--lost .sc-result-score { color: var(--ink-soft); }
.sc-result-last { font-size: 14px; color: var(--ink); margin-bottom: 4px; -unity-text-align: middle-center; white-space: normal; }

/* Start menu: the whole screen is the front wall. Plaster, the ball streaking in, the wordmark, the service line across
   the screen, the choices, and the tin along the bottom edge. */
.sc-menu-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    padding-left: 24px; padding-right: 24px; padding-top: 70px; padding-bottom: 56px;
    background-color: var(--plaster);
}
.sc-menu-art { width: 304px; height: 58px; margin-bottom: 4px; flex-shrink: 0; }
.sc-menu-title { font-size: 40px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); -unity-font-style: normal; color: var(--ink); -unity-text-align: middle-center; }
.sc-menu-tagline { font-size: 16px; color: var(--ink-soft); margin-top: 0; -unity-text-align: middle-center; }
.sc-menu-rule { align-self: stretch; flex-shrink: 0; height: 4px; margin-left: -24px; margin-right: -24px; margin-top: 22px; margin-bottom: 20px; background-color: var(--line); }
.sc-menu-tin { position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background-color: var(--line); }
.sc-menu-label { font-size: 14px; -unity-font-definition: url("../../Visual/Fonts/Rubik-Bold SDF.asset"); -unity-font-style: normal; color: var(--ink); margin-bottom: 8px; }
.sc-level-row { flex-direction: row; justify-content: center; margin-bottom: 18px; flex-shrink: 0; }
.sc-wall .unity-button.sc-level { width: 96px; height: 48px; font-size: 16px; margin-left: 4px; margin-right: 4px; border-radius: 10px; }
/* The chosen level: ink, with the ball's yellow along its lower edge. */
.sc-wall .unity-button.sc-level--selected { background-color: var(--ink); border-color: var(--ink); border-bottom-color: var(--dot); border-bottom-width: 4px; color: var(--plaster); }
.sc-wall .unity-button.sc-menu-play { width: 304px; height: 64px; font-size: 28px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); border-radius: 14px; margin-bottom: 12px; }
.unity-button.sc-menu-wide { width: 304px; height: 50px; font-size: 16px; margin-bottom: 10px; }
.sc-menu-build { position: absolute; left: 0; right: 0; bottom: 30px; font-size: 11px; color: var(--ink-soft); -unity-text-align: middle-center; }

/* Tutorial: the same wall, with a card per step. The drawing sits on ink, like the court seen from the glass. */
.sc-tutorial-card {
    width: 338px;
    padding: 20px;
    align-items: center;
    background-color: var(--plaster-card);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--ink-line);
    border-top-width: 6px;
    border-top-color: var(--line);
}
.sc-tutorial-card .sc-menu-label { color: var(--line); }
.sc-tutorial-art { width: 270px; height: 150px; margin-top: 4px; margin-bottom: 16px; border-radius: 12px; background-color: var(--ink); overflow: hidden; }
.sc-tutorial-title { font-size: 28px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); -unity-font-style: normal; color: var(--ink); margin-bottom: 8px; -unity-text-align: middle-center; }
.sc-tutorial-body { font-size: 16px; color: var(--ink); white-space: normal; -unity-text-align: upper-left; width: 100%; margin-bottom: 12px; }
.sc-tutorial-results { width: 100%; margin-bottom: 8px; }
.sc-tutorial-result { flex-direction: row; align-items: flex-start; margin-bottom: 6px; }
.sc-tutorial-chip { width: 12px; height: 12px; border-radius: 6px; margin-top: 4px; margin-right: 8px; flex-shrink: 0; border-width: 2px; border-color: var(--ink-soft); }
.sc-tutorial-chip--perfect { background-color: var(--dot); border-color: rgb(214, 166, 0); }
.sc-tutorial-chip--valid { background-color: rgb(255, 255, 255); border-color: var(--ink); }
.sc-tutorial-result-text { font-size: 14px; color: var(--ink); white-space: normal; flex-shrink: 1; flex-grow: 1; }
.sc-tutorial-buttons { flex-direction: row; justify-content: space-between; width: 100%; margin-top: 8px; }
.unity-button.sc-tutorial-skip { width: 104px; height: 52px; font-size: 15px; margin-left: 0; }
.sc-wall .unity-button.sc-tutorial-next { width: 176px; height: 52px; font-size: 20px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); margin-right: 0; }

/* Pause: the court stays visible behind a light scrim; the card is a piece of the wall. */
.sc-pause-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 22, 27, 0.55);
}
.sc-pause-card { border-top-color: var(--line); }
.sc-pause-title { font-size: 28px; -unity-font-definition: url("../../Visual/Fonts/Rubik-BoldItalic SDF.asset"); -unity-font-style: normal; letter-spacing: 3px; color: var(--ink); margin-bottom: 18px; }
.unity-button.sc-pause-button { width: 240px; height: 54px; font-size: 18px; margin-bottom: 10px; }

/* Device robustness: sound and music switches side by side, in the menu and in the pause card. */
.sc-menu-pair { flex-direction: row; justify-content: space-between; width: 304px; margin-bottom: 10px; flex-shrink: 0; }
.unity-button.sc-menu-half { width: 148px; height: 50px; font-size: 15px; margin-left: 0; margin-right: 0; }
.sc-pause-pair { flex-direction: row; justify-content: space-between; width: 240px; margin-bottom: 10px; flex-shrink: 0; }
.unity-button.sc-pause-half { width: 116px; height: 54px; font-size: 15px; margin-left: 0; margin-right: 0; }
